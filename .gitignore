# --- credentials and per-machine state -----------------------------------
# config.json holds the bot token and the owner's chat id. Never commit it.
config.json
config.json.*
state.json
state.db
# The Mini App's HS256 signing secret. It is generated into the bridge's
# state directory (chmod 600) rather than here, but a MINIAPP_SECRET_PATH
# pointed inside the repo must not be able to leak it.
miniapp-secret.json
# Per-install Mini App state: the owner's chosen defaults and the list of
# sessions running the soft-confirm protocol. Neither is shareable and
# both used to be untracked-but-not-ignored, so a `git add -A` would have
# committed them.
miniapp-settings.json
miniapp-soft-confirm.json
.env
.env.*

# --- logs ----------------------------------------------------------------
*.log
*.log.1

# --- runtime data --------------------------------------------------------
# Photos and documents that arrived over Telegram, and files uploaded from
# the phone through the Mini App. Both are the owner's own files.
media/
miniapp-uploads/
# The downloaded cloudflared binary and the marker recording what it was
# verified against.
bin/
backups/

# --- build output --------------------------------------------------------
node_modules/
dist/
__pycache__/
*.pyc

# --- local-only tooling, not part of the published project ---------------
.DS_Store
# A stray nested checkout of this same repo; never part of a release.
/aside-telegram-bridge/
# Scratch harness used to render the web app at phone size during review.
miniapp/web/dist/__preview.html
channel-guard*.py
channel-guard*.json
monitor-native-channel.py
rollback-native-migration.sh
